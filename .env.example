APP_URL=http://localhost:3000

# Supabase OKF database access. Service role is server-side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OKF LLM synthesis. Gemini and Groq calls are server-side only; use none for deterministic mode.
LLM_PROVIDER=none
# Provider-neutral production guardrails. Daily safe mode skips the optional
# query-planner call; canonical design-reuse synthesis remains single-attempt.
LLM_DAILY_SAFE_MODE=false
LLM_DISABLE_LIVE_SYNTHESIS=false
LLM_MAX_PROMPT_CHARS=12000
LLM_MAX_CONTEXT_EVIDENCE=15
LLM_MAX_EVIDENCE_PER_MOVE=3
LLM_MAX_MOVES=7
LLM_REQUEST_CACHE_TTL_MS=86400000
# Optional cost rates; leave blank to disable cost estimation.
LLM_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PLANNER_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=2500
GEMINI_TEMPERATURE=0.2
GEMINI_LIVE_TEST=false
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TIMEOUT_MS=60000
GROQ_MAX_TOKENS=1600
GROQ_TEMPERATURE=0.2

# Optional local/RAG variables used by older experiments.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen3-8b
EMBEDDING_API_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_API_KEY=lm-studio
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
RAG_MATCH_COUNT=8
RAG_CHUNK_MAX_CHARS=1200
EMBEDDING_TIMEOUT_MS=120000
LLM_TIMEOUT_MS=900000
LLM_MAX_TOKENS=4096
LLM_DISABLE_THINKING=true

# Native OKF OpenAI assistant (server-only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_ENABLE_MODERATION=true
OPENAI_MAX_OUTPUT_TOKENS=1800
OPENAI_DIAGRAM_MAX_OUTPUT_TOKENS=4096

# Native OKF application-owned access and usage controls (server-only)
# Missing or invalid access modes must behave as disabled.
NATIVE_OKF_CHAT_ENABLED=false
NATIVE_OKF_ACCESS_MODE=disabled
NATIVE_OKF_SESSION_SECRET=
NATIVE_OKF_INVITE_HASH_SECRET=
NATIVE_OKF_TEST_ACCESS_CODE=
NATIVE_OKF_ADMIN_ACCESS_CODE=
NATIVE_OKF_ADMIN_SESSION_SECRET=
NATIVE_OKF_USAGE_DB_PATH=runtime/native-okf-usage.sqlite

# Private test-mode quotas
NATIVE_OKF_TEST_DAILY_QUESTIONS=20
NATIVE_OKF_TEST_DAILY_DIAGRAMS=5
NATIVE_OKF_TEST_TOTAL_QUESTIONS=100
NATIVE_OKF_TEST_TOTAL_DIAGRAMS=25
NATIVE_OKF_TEST_HARD_DAILY_USD=2.00
NATIVE_OKF_TEST_HARD_MONTHLY_USD=8.00

# Invitation defaults and per-invitation quotas
NATIVE_OKF_INVITE_DEFAULT_VALID_DAYS=14
NATIVE_OKF_INVITE_DAILY_QUESTIONS=12
NATIVE_OKF_INVITE_DAILY_DIAGRAMS=3
NATIVE_OKF_INVITE_TOTAL_QUESTIONS=25
NATIVE_OKF_INVITE_TOTAL_DIAGRAMS=8

# Rate, cooldown and concurrency limits
NATIVE_OKF_PER_INVITE_RPM=4
NATIVE_OKF_GLOBAL_RPM=12
NATIVE_OKF_IP_REQUESTS_PER_HOUR=60
NATIVE_OKF_REQUEST_COOLDOWN_SECONDS=5
NATIVE_OKF_MAX_CONCURRENT_PER_INVITE=1
NATIVE_OKF_MAX_GLOBAL_CONCURRENT=3

# Global external-call budgets and conservative pre-request reservations
NATIVE_OKF_HARD_DAILY_USD=3.00
NATIVE_OKF_HARD_MONTHLY_USD=20.00
NATIVE_OKF_TEXT_REQUEST_RESERVE_USD=0.08
NATIVE_OKF_DIAGRAM_REQUEST_RESERVE_USD=0.18
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_CACHED_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=

# Session, proxy and administrative hardening
NATIVE_OKF_TRUST_PROXY=false
NATIVE_OKF_TRUSTED_PROXY_HEADER=x-forwarded-for
NATIVE_OKF_TRUSTED_PROXY_HOPS=1
NATIVE_OKF_PUBLIC_ORIGIN=
NATIVE_OKF_ADMIN_SESSION_MINUTES=30
NATIVE_OKF_RESEARCHER_SESSION_HOURS=24
NATIVE_OKF_RESERVATION_TTL_SECONDS=1800
NATIVE_OKF_ADMIN_MUTATIONS_PER_MINUTE=10
