NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. If omitted, chat auto-selects Featherless when FEATHERLESS_API_KEY and FEATHERLESS_MODEL are set; otherwise local.
CHAT_PROVIDER=featherless
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=
FEATHERLESS_TIMEOUT_MS=60000

LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen3-8b
EMBEDDING_API_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_API_KEY=lm-studio
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
RAG_MATCH_COUNT=8
RAG_CHUNK_MAX_CHARS=1200
EMBEDDING_TIMEOUT_MS=120000
LLM_TIMEOUT_MS=900000
LLM_MAX_TOKENS=4096
LLM_DISABLE_THINKING=true

