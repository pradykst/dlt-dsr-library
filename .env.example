APP_URL=http://localhost:3000

# Supabase OKF database access. Service role is server-side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OKF LLM synthesis. Featherless calls are server-side only; use none for deterministic mode.
LLM_PROVIDER=none
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=
FEATHERLESS_TIMEOUT_MS=60000
FEATHERLESS_MAX_TOKENS=1800
FEATHERLESS_TEMPERATURE=0.2
FEATHERLESS_LIVE_TEST=false

# Optional local/RAG variables used by older experiments.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen3-8b
EMBEDDING_API_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_API_KEY=lm-studio
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
RAG_MATCH_COUNT=8
RAG_CHUNK_MAX_CHARS=1200
EMBEDDING_TIMEOUT_MS=120000
LLM_TIMEOUT_MS=900000
LLM_MAX_TOKENS=4096
LLM_DISABLE_THINKING=true
